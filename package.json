{
  "name": "trivia-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,admin,student -c blue,green,magenta \"npm run dev --workspace=@trivia/api\" \"npm run dev --workspace=@trivia/web\" \"npm run dev --workspace=@trivia/student\"",
    "build": "npm run build --workspaces --if-present",
    "start:api": "npm run start --workspace=@trivia/api",
    "db:generate": "npm run prisma:generate --workspace=@trivia/api",
    "db:migrate": "npm run prisma:migrate --workspace=@trivia/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
