generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Quiz {
  id          Int        @id @default(autoincrement())
  guid        String     @unique @default(uuid()) @db.Uuid
  title       String
  description String?
  randomizeQuestionOrder Boolean @default(false)
  theme       String     @default("standard")
  startedAt   DateTime   @default(now())
  endedAt     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  questions   Question[]
}

model Question {
  id           Int         @id @default(autoincrement())
  quizId       Int
  position     Int
  isEnabled    Boolean     @default(true)
  answerPoolId Int?
  answerCount  Int?
  text         String
  options      Json
  correctAnswer String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  quiz         Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answerPool   AnswerPool? @relation(fields: [answerPoolId], references: [id], onDelete: SetNull)

  @@index([answerPoolId])
  @@index([quizId, position])
}

model CommonQuestion {
  id           Int         @id @default(autoincrement())
  answerPoolId Int?
  answerCount  Int?
  text         String
  options      Json
  correctAnswer String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  answerPool   AnswerPool? @relation(fields: [answerPoolId], references: [id], onDelete: SetNull)

  @@index([answerPoolId])
}

model AnswerPool {
  id              Int                 @id @default(autoincrement())
  name            String              @unique
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  answers         AnswerPoolAnswer[]
  questions       Question[]
  commonQuestions CommonQuestion[]
}

model AnswerPoolAnswer {
  id           Int        @id @default(autoincrement())
  answerPoolId Int
  value        String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  answerPool   AnswerPool @relation(fields: [answerPoolId], references: [id], onDelete: Cascade)

  @@unique([answerPoolId, value])
}
