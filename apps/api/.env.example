# PostgreSQL connection used by Prisma and NestJS.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/trivia?schema=public"
# Comma-separated browser origins permitted by CORS.
CLIENT_ORIGIN="http://localhost:5173,http://localhost:5174"
# OAuth 2.0 Web client ID used to verify Google ID tokens.
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
# Keep this server-only. It is not used by the current popup sign-in flow.
GOOGLE_CLIENT_SECRET=""
